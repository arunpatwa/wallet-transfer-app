# ---------------------------------------------------------------------------
# 12-factor configuration. Copy to .env for local development.
# Every value here is a placeholder or a safe default -- no real secret is ever
# committed. In production these come from the host's environment.
# ---------------------------------------------------------------------------

# --- required ---------------------------------------------------------------

# Postgres connection string.
#   local:  postgres://wallet:wallet@localhost:5432/wallet
#   compose: postgres://wallet:wallet@db:5432/wallet
#
# Supabase: use the CONNECTION POOLER host, not the direct one. The free tier
# assigns no IPv4 address to the direct connection (port 5432 direct is
# IPv6-only; the IPv4 add-on is paid) and Render's egress is IPv4, so the
# pooler is the only reachable endpoint. Session mode gives full session
# semantics; transaction mode (port 6543) also works.
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet

# HS256 signing secret for access tokens. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-value

# --- server -----------------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# --- database ---------------------------------------------------------------

# Require TLS to Postgres. Managed providers: true. Local Postgres: false.
DATABASE_SSL=false

DB_POOL_MAX=10

# Fail closed rather than hang. These bound how long a request may wait, and
# are applied per-transaction with SET LOCAL (not at pool level) because the
# connection may be pooled and must not be assumed to carry session state.
DB_STATEMENT_TIMEOUT_MS=3000
DB_LOCK_TIMEOUT_MS=2500
DB_CONNECT_TIMEOUT_MS=5000

# --- tokens -----------------------------------------------------------------
JWT_ISSUER=wallet-transfer-app
JWT_TTL_SECONDS=3600

# --- demo endpoints ---------------------------------------------------------
# Both exist so the correctness gate is runnable with one command against a
# live URL. Neither is part of the production surface.
#
#   DEV_TOKEN_ENABLED -> POST /auth/token mints a token for a given user_id.
#                        Stands in for a real identity provider. The service
#                        itself only ever VERIFIES tokens.
#   FAUCET_ENABLED    -> POST /dev/credit moves money treasury -> caller along
#                        the normal transfer path, so total money stays
#                        conserved and auditable.
DEV_TOKEN_ENABLED=true
FAUCET_ENABLED=true
FAUCET_MAX_PAISE=10000000

# --- observability ----------------------------------------------------------
# Size of the in-memory ring buffer backing the public GET /logs viewer.
LOG_BUFFER_SIZE=1000
